rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ספריות השירים: כל משתמש רואה וכותב רק את שלו
    match /users_libraries/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // מונה ביקורים: כל אחד יכול רק להוסיף/לעדכן ביקור. לקרוא - רק tal123t123@gmail.com
    match /visits/{visitId} {
      allow read: if request.auth != null
        && request.auth.token.email == "tal123t123@gmail.com"
        && request.auth.token.email_verified == true;
      allow create: if validVisit(visitId);
      allow update: if validVisit(visitId)
        && request.resource.data.v == resource.data.v
        && request.resource.data.s == resource.data.s;
      allow delete: if false;
    }

    function validVisit(visitId) {
      return visitId.size() <= 80
        && request.resource.data.keys().hasOnly(["v", "e", "s", "l", "d", "dev"])
        && request.resource.data.keys().hasAll(["v", "e", "s", "l", "d", "dev"])
        && request.resource.data.v is string && request.resource.data.v.size() <= 40
        && request.resource.data.s is int && request.resource.data.l is int
        && request.resource.data.d is int && request.resource.data.d >= 0 && request.resource.data.d <= 86400
        && request.resource.data.dev is string && request.resource.data.dev.size() <= 40
        && (request.resource.data.e == null
            || (request.auth != null && request.resource.data.e == request.auth.token.email));
    }
  }
}
